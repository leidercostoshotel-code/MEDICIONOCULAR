rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo usuarios que iniciaron sesión pueden leer y escribir (datos de salud de menores).
    match /pacientes/{id} {
      allow read, write: if request.auth != null;
    }
    match /evaluaciones/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
