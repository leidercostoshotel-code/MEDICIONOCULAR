rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo usuarios que iniciaron sesión pueden leer y escribir (datos de salud de menores).
    match /pacientes/{id} {
      allow read, write: if request.auth != null;
    }
    match /evaluaciones/{id} {
      allow read, write: if request.auth != null;
    }
    // Salud Ocular · REGISTRO HIS
    match /his_atenciones/{id} {
      allow read, write: if request.auth != null;
    }
    match /his_config/{id} {
      allow read, write: if request.auth != null;
    }
    // PCT · Paciente con Tuberculosis
    match /pct_pacientes/{id} {
      allow read, write: if request.auth != null;
    }
    match /pct_atenciones/{id} {
      allow read, write: if request.auth != null;
    }
    match /pct_config/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
